DATABASE_URL="file:./dev.db"

# Google Calendar sync (Phase 5) — see docs/google-calendar-setup.md to
# create these. Redirect URI to register: {APP_URL}/api/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APP_URL="http://localhost:3000"

# Powers /tasks/import (paste a syllabus, extract due dates) — get one at
# https://console.anthropic.com. Unset = the import page shows a setup
# message instead of erroring. Any signed-in user can also set their own
# key (or point at a hosted OpenAI-compatible API like MiniMax) from
# Settings → AI, with no .env edit at all — this is only the fallback for
# accounts that haven't.
ANTHROPIC_API_KEY=""

# Encrypts the stored Google access/refresh tokens at rest (any string —
# it's run through scrypt, doesn't need to already be 32 random bytes).
# Unset = tokens are stored in plaintext, same as before this existed.
# Strongly recommended before self-hosting this publicly.
TOKEN_ENCRYPTION_KEY=""

# When set, signup requires this code (an "Invite code" field appears on
# the signup form). Unset = open signup, anyone can create an account —
# fine while this isn't public; set this before sharing the app's URL
# with anyone you haven't personally invited.
SIGNUP_INVITE_CODE=""

# Powers "Forgot password" (a real emailed reset link, not just the
# logged-in "change password" in Settings). Plain SMTP works with any
# provider — a Gmail app password, Postmark, Resend, or a self-hosted
# server — so there's nothing to pick beyond host/port/credentials.
# Unset SMTP_HOST = the forgot-password page shows a setup message
# instead of erroring.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Defaults to SMTP_USER if unset.
SMTP_FROM=""

# Required to enable /api/test/* helper routes used by the Playwright
# suite (`E2E_TEST_ROUTES=1 npm run dev`). Leave unset always in any
# environment other than your own local dev machine — these routes have
# no auth check of their own beyond this flag and can create/delete data.
E2E_TEST_ROUTES=""
