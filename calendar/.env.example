DATABASE_URL="file:./dev.db"

# Google Calendar sync (Phase 5) — see docs/google-calendar-setup.md to
# create these. Redirect URI to register: {APP_URL}/api/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APP_URL="http://localhost:3000"

# Set this before sharing your /book/<slug> link with anyone. This app has
# no user system — every page and server action is otherwise wide open to
# anyone who can reach the host. Unset = auth disabled (fine for local
# dev only). Once set, everything except /book/* and /login requires this
# password (src/middleware.ts).
APP_PASSWORD=""
