generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Real per-person accounts (added when this moved from a single-user app
// toward self-hosted + friends). userId columns below are nullable rather
// than required — this app ran for a while as genuinely single-user with
// no User table at all, and a hard NOT NULL migration against that
// pre-existing data risks an unrecoverable failure. Instead, the first
// person to sign up (src/app/authActions.ts) adopts every row that still
// has userId: null, and every write from that point on always sets it —
// nullable is a migration safety valve, not a supported "ownerless" state.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  // The first account created (during the single-user -> multi-user
  // migration, or on a fresh install) — gates the feedback inbox and any
  // future admin-only surface. Not a general role system.
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  // IANA zone name (e.g. "America/Chicago") the scheduler/booking-page/
  // Google-sync-export code treats as *this account's* timezone (#46).
  // Null = not yet detected — TimezoneSync.tsx auto-fills it from the
  // browser on first load after login; every server-side reader falls
  // back to the server process's own zone when null, so an existing
  // account's behavior doesn't change until its own browser sets this.
  timezone     String?

  sessions      Session[]
  events        Event[]
  tasks         Task[]
  projects      Project[]
  googleAccounts GoogleAccount[]
  appleAccount  AppleAccount?
  settings      AppSettings?
  assignees     Assignee[]
  feedback      Feedback[]
  bookingLinks  BookingLink[]
  labels        Label[]
  passwordResetTokens PasswordResetToken[]
  automationRules         AutomationRule[]
  automationNotifications AutomationNotification[]
  timeLogEntries          TimeLogEntry[]
  habits                  Habit[]
  timeSlots               TimeSlot[]
  sharesGiven             CalendarShare[] @relation("SharesGiven")
  sharesReceived          CalendarShare[] @relation("SharesReceived")
  calendarSubscriptions   CalendarSubscription[]
}

// DB-backed sessions (not signed/stateless JWTs) — lets a logout or a
// password change actually revoke access immediately, which a bare signed
// cookie can't do without a separate revocation list anyway.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Event {
  id              String      @id @default(cuid())
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  // Video-call link (Zoom/Meet/whatever) shown by MeetingBanner.tsx when
  // the event's about to start — plain URL, no per-provider parsing.
  meetingUrl      String?
  start           DateTime
  end             DateTime
  allDay          Boolean     @default(false)
  notes           String?
  // Explicit override of the Tailwind color family this event's block
  // renders in (see PROJECT_EVENT_COLORS in CalendarClient.tsx). Null =
  // fall back to the linked task's own color, then its project's, then
  // the default indigo — same resolution page.tsx already does for
  // projectColor.
  color           String?
  // RRULE string (no DTSTART line — `start` above is the recurrence's
  // DTSTART), e.g. "FREQ=WEEKLY;BYDAY=MO,WE,FR". Null = a one-off event.
  // Occurrences are computed on the fly (src/lib/recurrence.ts), never
  // materialized as rows — editing/deleting acts on the whole series.
  recurrenceRule  String?
  // Excluded from auto-rescheduling (src/lib/scheduler.ts's stale-task
  // sweep never moves a locked event, even if its slot looks stale).
  locked          Boolean     @default(false)
  // Out-of-office/focus-time as distinct event types (#36) — mostly a
  // display distinction (a badge on the block, its own color) rather
  // than new scheduling behavior: both types already block scheduling
  // like any other event via fetchBusyIntervals, and Google's own
  // "auto-decline conflicting invites" doesn't map onto this app's
  // guest model (a guest here is an external email invited to *your*
  // event, never you being invited to someone else's — there's nothing
  // to auto-decline on your behalf).
  eventType       EventType   @default(DEFAULT)
  // Minutes before start to fire a browser reminder notification. Null =
  // no reminder (Google Calendar's own "None" option) — the app-wide
  // 10-minute default lived only in NotificationWatcher.tsx before this;
  // moving it here makes it per-event instead of fixed for every event.
  reminderMinutes Int?        @default(10)
  // Not unique — a chunked task (Task.chunkMin set) places 2+ Event rows
  // sharing one taskId, same "occurrences share a parent id" shape as
  // Habit below. An unchunked task still has at most one.
  taskId          String?
  task            Task?       @relation(fields: [taskId], references: [id])
  // A Habit occurrence, unlike a Task's slot, isn't 1:1 — a habit with
  // timesPerWeek: 3 has 3 Event rows sharing the same habitId each week,
  // so no unique constraint here (see Habit below).
  habitId         String?
  habit           Habit?      @relation(fields: [habitId], references: [id], onDelete: Cascade)
  // Google Calendar sync (src/lib/google-sync.ts). source LOCAL means
  // this app owns it and pushes it to Google; GOOGLE means it was pulled
  // from Google and edits here get pushed back. Dirty tracking can't use
  // updatedAt (Prisma's @updatedAt bumps it on every write, including
  // google-sync's own bookkeeping, which would mark every row dirty on
  // every sync) — localDirty is set only by actual user edits and cleared
  // once exportToGoogle successfully pushes it.
  source          EventSource @default(LOCAL)
  // Which of the user's (possibly several) connected Google accounts
  // this event syncs to. Null = not tied to a specific account yet — an
  // untagged LOCAL event exports to whichever account is currently
  // isDefault (see exportToGoogle); it's tagged with that account's id
  // the moment it's first pushed, so a later default change doesn't
  // reroute an event that already has a home. SetNull on delete: the
  // event just stops syncing, it isn't destroyed with the account.
  googleAccountId String?
  googleAccount   GoogleAccount? @relation(fields: [googleAccountId], references: [id], onDelete: SetNull)
  googleEventId   String?
  googleUpdatedAt DateTime?
  localDirty      Boolean     @default(false)
  // CalDAV UID for Apple-synced events (src/lib/apple-sync.ts) — read-only
  // overlay, no push-back, so unlike Google there's no dirty-tracking here.
  appleEventUid   String?     @unique
  // ICS-subscription overlay (#32, src/lib/calendarSubscriptions.ts) — same
  // read-only, locked, no-push-back treatment as Apple, but scoped to one
  // subscription's uid rather than globally unique (two different
  // subscription URLs could reuse the same UID).
  subscriptionId       String?
  subscription         CalendarSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  subscriptionEventUid String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Recurring event exceptions (#40) — comma-joined ISO timestamps of
  // this series' own occurrence starts that no longer show as regular
  // occurrences (RFC 5545 EXDATE, as a plain string instead of a second
  // RRULE-family field). Filtered centrally in recurrence.ts's
  // expandEventOccurrences, so every caller (scheduler, agenda,
  // notifications, the main grid) gets the exclusion for free with no
  // per-caller plumbing.
  excludeDates    String?
  // Set on the override row itself (not the master) when this event
  // replaces one occurrence of another recurring event's series — a
  // plain one-off Event otherwise, editable/deletable through the
  // normal single-event flow with no series concept. Deleting the
  // master cascades to its overrides too (a deleted series shouldn't
  // leave edited-occurrence orphans behind).
  recurrenceExceptionOfId     String?
  recurrenceExceptionOf       Event?   @relation("RecurrenceExceptions", fields: [recurrenceExceptionOfId], references: [id], onDelete: Cascade)
  recurrenceExceptionOverrides Event[] @relation("RecurrenceExceptions")
  recurrenceOriginalStart      DateTime?

  guests          EventGuest[]

  // Every calendar-range query (the main grid, fetchBusyIntervals,
  // "Upcoming") filters by userId + an overlap on start/end — a plain
  // foreign-key index on userId alone doesn't help an ORDER/range scan
  // on start. Free to add now, before rows accumulate over months.
  @@index([userId, start])
  @@unique([subscriptionId, subscriptionEventUid])
  @@unique([googleAccountId, googleEventId])
}

/**
 * Event guests + RSVP (#34) — an invited email, not necessarily a real
 * `User` of this app (v1's whole point is inviting people who don't
 * have an account here), so identity is the invite email + a random
 * respond token rather than a userId. One email invited twice to the
 * same event just re-sends/updates the same row (@@unique below).
 */
model EventGuest {
  id           String      @id @default(cuid())
  eventId      String
  event        Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  email        String
  name         String?
  status       RsvpStatus  @default(PENDING)
  respondToken String      @unique
  createdAt    DateTime    @default(now())
  respondedAt  DateTime?

  @@unique([eventId, email])
}

enum RsvpStatus {
  PENDING
  ACCEPTED
  DECLINED
  TENTATIVE
}

/**
 * A subscribed external calendar (#32) — an ICS URL (holidays, a
 * friend's public calendar) periodically fetched and overlaid read-only,
 * same "materialize into Event rows, locked, no push-back" treatment as
 * Apple sync already uses. Manually-triggered + auto-synced-if-stale the
 * same way Google's connection is (this app has no background cron).
 */
model CalendarSubscription {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  url           String
  lastFetchedAt DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  events        Event[]
}

enum EventType {
  DEFAULT
  OUT_OF_OFFICE
  FOCUS_TIME
}

enum EventSource {
  LOCAL
  GOOGLE
  APPLE
  SUBSCRIBED
}

// One connected Google account per user (was a single global row back when
// this was single-user).
// Several of these can now belong to one user (e.g. personal + work) —
// see src/lib/google-sync.ts, which loops every connected account
// independently. userId stays nullable only for the pre-multi-user
// bootstrap adoption path in authActions.ts.
model GoogleAccount {
  id           String    @id @default(cuid())
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String
  // Display name distinguishing this account from a user's others (e.g.
  // "Personal", "Work") — defaults to the Google account's own email at
  // connect time, renameable after in Settings.
  label        String
  // Exactly one true per user is the app-level invariant (enforced in
  // actions.ts, not a DB constraint SQLite can't express cleanly) — the
  // account a brand-new local event exports to when it has no explicit
  // Event.googleAccountId of its own.
  isDefault    Boolean   @default(false)
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  // Google's primary calendar id (usually the account email) events sync
  // to/from — kept explicit rather than hardcoding "primary" everywhere.
  calendarId   String    @default("primary")
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  events       Event[]

  @@unique([userId, email])
}

// One connected Apple/iCloud CalDAV account per user — read-only overlay
// (src/lib/apple-sync.ts pulls events in as source: APPLE, locked so they
// can't be dragged; nothing is ever pushed back to iCloud), unlike the
// two-way Google sync above. Auth is an iCloud app-specific password
// (appleprivacy.apple.com/account/manage), not OAuth — Apple has no
// public CalDAV OAuth flow for third-party apps.
model AppleAccount {
  id           String    @id @default(cuid())
  userId       String?   @unique
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appleId      String
  // Encrypted at rest via src/lib/tokenCrypto.ts when TOKEN_ENCRYPTION_KEY
  // is set, same as Google's tokens.
  appPassword  String
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// A task's lifecycle is independent of whether it has a calendar slot
// (that's tracked by Event.taskId, not here) — CREATED/ONGOING tasks with
// no event yet are exactly what the auto-scheduler sweeps for. ONGOING
// can be set manually ("I'm working on this now") or is shown by the UI
// automatically whenever now falls inside the task's scheduled event
// window — that display-only computation isn't a stored value, see
// TaskRow.tsx. DELAYED always means "explicitly pushed off" (dueAt
// bumped, unscheduled if it had a slot) — it's a deliberate action, never
// inferred.
enum TaskStatus {
  CREATED
  ONGOING
  DELAYED
  DONE
}

// Deep-work tasks are scored toward morning slots, admin toward afternoon
// — see ENERGY_PREFERRED_HOURS in src/lib/scheduler.ts. The manual picker
// for this was removed from the task UI (defaults to MEDIUM = no
// preference) — the field and scheduler logic stay, since the plan is to
// eventually derive this automatically (e.g. from sleep/energy data)
// rather than have the user pick it by hand.
enum TaskEnergy {
  LOW
  MEDIUM
  HIGH
}

// Who a task is assigned to — a person (you, a friend) or an "AI
// employee". Deliberately just a label for now: assigning a task to an AI
// employee puts it on their name/calendar like any teammate, but nothing
// autonomously executes it yet. See docs/motion-feature-backlog.md.
enum AssigneeType {
  HUMAN
  AI
}

model Assignee {
  id        String       @id @default(cuid())
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  role      String?
  type      AssigneeType @default(HUMAN)
  tasks     Task[]
  createdAt DateTime     @default(now())
}

// Auto-scheduling inputs, modeled after FluidCalendar's scoring approach
// (due date / priority / duration) — see docs/fluidcalendar.md.
model Task {
  id             String     @id @default(cuid())
  userId         String?
  user           User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  notes          String?
  status         TaskStatus @default(CREATED)
  priority       Int        @default(0) // 0 = low .. 3 = urgent
  energy         TaskEnergy @default(MEDIUM)
  durationMin    Int        @default(30) // the estimate
  // Splits durationMin into ~chunkMin-sized Event rows instead of one
  // block (e.g. a 3h task with chunkMin=60 -> three 1h chunks), each
  // separated by at least the user's own bufferMin setting — reusing
  // that existing knob rather than adding a second "gap between chunks"
  // setting nobody's asked for yet. Null/unset, or >= durationMin, means
  // no chunking (one block, same as before this field existed).
  chunkMin       Int?
  // Actual time tracked, accumulated across every ONGOING session (not
  // just the current one) — see finalizeTaskTimer in src/app/actions.ts.
  trackedMinutes Int        @default(0)
  // Set when the task becomes ONGOING (manually, via the timer), cleared
  // and folded into trackedMinutes whenever it leaves ONGOING. Null =
  // no timer currently running.
  timerStartedAt DateTime?
  // Earliest day the scheduler may place this task — optional, unlike
  // dueAt. A plain lower bound on scheduling, not a hard commitment like
  // an Event's start.
  startAt        DateTime?
  dueAt          DateTime?
  // Hard = a real commitment the scheduler must prioritize getting a
  // slot before the due date over anything soft, even a higher-
  // priority soft task (Motion's documented precedence: hard deadlines
  // outrank soft ones outright, priority is only a tiebreaker within the
  // same tier — see scheduleAllPendingTasks' orderBy). Soft = "want to
  // get to it by then," fine to bump for something more pressing.
  // Defaults true since most due dates people actually set are real
  // commitments, not aspirational ones.
  hardDeadline   Boolean    @default(true)
  // RRULE string, same format as Event.recurrenceRule, anchored to
  // `dueAt` (a recurring task must have a dueAt — it's the DTSTART for
  // computing the next occurrence). Unlike Events, occurrences ARE
  // materialized: marking a recurring task done creates the next Task
  // row rather than expanding virtual instances, since a task carries
  // per-instance mutable state (status, its own scheduled event) that
  // doesn't fit the "compute on the fly" model Events use.
  recurrenceRule String?
  // Explicit override of the Tailwind color family this task (and its
  // scheduled Event block, if any) renders in. Null = fall back to the
  // project's color, then the default indigo.
  color          String?
  projectId      String?
  project        Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assigneeId     String?
  assignee       Assignee?  @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  // Restricts auto-scheduling to this slot's own windows (e.g. "School")
  // instead of the default 9-6 weekday work window. Null = default.
  timeSlotId     String?
  timeSlot       TimeSlot?  @relation(fields: [timeSlotId], references: [id], onDelete: SetNull)
  // Plural since a chunked task (chunkMin set) has 2+ rows — one per
  // chunk, all sharing this taskId. An unchunked task still has at most
  // one. Ordered by start wherever "the next chunk"/"is it scheduled"
  // matters — see scheduler.ts and TaskRow.tsx.
  events         Event[]
  // One level of subtasks (a subtask can't itself have subtasks — this
  // app doesn't enforce that in the schema, but nothing in the UI ever
  // creates a subtask of a subtask). Deleting the parent deletes its
  // subtasks rather than orphaning them.
  parentId       String?
  parent         Task?      @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks       Task[]     @relation("TaskSubtasks")
  timeLogEntries TimeLogEntry[]
  attachments    TaskAttachment[]
  activity       TaskActivity[]
  // Cross-cutting tags (Motion's "Labels"), separate from Project — a
  // task can carry several, unlike the one Project it belongs to.
  labels         Label[]
  // Self-referential many-to-many: a blocked task shouldn't be
  // auto-scheduled until everything in `blockedBy` is DONE (see the
  // sweep guard in scheduler.ts). `blocking` is just the inverse view,
  // Prisma auto-derives both sides of one join table from a shared
  // relation name.
  blockedBy      Task[]     @relation("TaskDependency")
  blocking       Task[]     @relation("TaskDependency")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // The Tasks page's own open-tasks query and the calendar sidebar's
  // "Needs attention" query both filter by userId + status, ordering by
  // dueAt — same reasoning as Event's (userId, start) index above.
  @@index([userId, status])
  @@index([userId, dueAt])
}

// A file attached to a task. No multi-account sharing exists on Task
// (Assignee is just a label under the owning account, not a real second
// User — real accounts only share calendars, per CalendarShare) so this
// is always read/written by the task's own owner, never a second party.
model TaskAttachment {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // Original filename, display-only — never used to build the on-disk
  // path (see the upload route for why: no path-traversal/extension
  // surface from a client-supplied name).
  filename   String
  storedPath String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())
}

// A running log on a task: auto-recorded field changes (from updateTask's
// before/after diff) plus freeform comments. Single-user notes-to-self,
// same ownership reasoning as TaskAttachment above — not a multi-party
// discussion thread.
model TaskActivity {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // "comment" | "priority" | "dueDate" | "assignee" — kept as a plain
  // String rather than an enum since `detail` already carries the real
  // meaning and a comment's `kind` never drives branching logic beyond
  // "is this the free-text one."
  kind      String
  detail    String
  createdAt DateTime @default(now())
}

// Lightweight tag, not a full custom-field builder — quick visual
// grouping cross-cutting projects (e.g. "urgent-client", "reading").
model Label {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("zinc")
  tasks     Task[]
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

// One row per timer stop (see stoppedTimerFields in actions.ts) — lets
// the time-tracking report bucket by week/project, which the plain
// cumulative Task.trackedMinutes total can't do on its own.
model TimeLogEntry {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId   String
  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  minutes  Int
  loggedAt DateTime @default(now())
}

// Per-user scheduler knobs and booking-page config (was a single global
// row back when this was single-user).
model AppSettings {
  id                 String   @id @default(cuid())
  userId             String?  @unique
  user               User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  bufferMin          Int      @default(10)
  // "Breathing room" — once a day's already-scheduled task minutes (within
  // work hours) reach this, the auto-scheduler stops placing new tasks
  // that day and moves on to the next, leaving slack for unplanned work
  // instead of packing every open slot. Null = no cap (previous behavior).
  dailyCapMin        Int?
  // The user-facing "these are my working hours" declaration (#35) —
  // promotes the scheduler's old hardcoded 9-6 weekday default into a
  // real per-user setting. Same "SU,MO,..." format as TimeSlot.daysOfWeek
  // and minutes-since-midnight format as TimeSlot.startMin/endMin, so
  // scheduler.ts can build a WindowFn from either with one helper.
  workDays           String   @default("MO,TU,WE,TH,FR")
  workStartMin       Int      @default(540)
  workEndMin         Int      @default(1080)
  // World clock (#37) — an IANA zone name (e.g. "Europe/London") shown as
  // a second set of hour labels in the week/day grid gutter. Null = off.
  secondaryTimezone  String?
  // Optional self-hosted model for /tasks/import (e.g. Ollama on a home
  // desktop, reachable at a Tailscale address from other devices) — an
  // OpenAI-compatible chat-completions endpoint. When set, syllabus
  // extraction calls this instead of the Claude API, so it isn't
  // subscription-dependent. Null = use Claude (needs ANTHROPIC_API_KEY).
  localAiUrl         String?
  localAiModel       String?
  // Encrypted the same way as Google/Apple credentials (tokenCrypto.ts)
  // when TOKEN_ENCRYPTION_KEY is set — a Bearer token for a hosted
  // OpenAI-compatible API (MiniMax, etc.), not just an unauthenticated
  // local Ollama/LM Studio endpoint. Optional: local endpoints with no
  // auth of their own leave this null.
  localAiApiKey      String?
  // Per-account override of the server's ANTHROPIC_API_KEY env var —
  // lets a self-hosted instance's AI features work for a given user
  // without the operator ever touching .env. Same encryption-at-rest
  // treatment as localAiApiKey. Falls back to the env var when unset, so
  // an existing single-key .env setup keeps working unchanged.
  anthropicApiKey    String?
  updatedAt          DateTime @updatedAt
}

model Project {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  // Tailwind color family name (e.g. "indigo", "amber") used to derive
  // badge/pill classes — see PROJECT_COLORS in src/app/page.tsx.
  color     String   @default("zinc")
  tasks     Task[]
  automationRules AutomationRule[]
  createdAt DateTime @default(now())
}

enum FeedbackCategory {
  BUG
  SUGGESTION
  OTHER
}

// Free-form in-app feedback (feedback button, any page) — lands here
// instead of email/Slack so it's queryable while iterating on the app.
model Feedback {
  id        String           @id @default(cuid())
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  category  FeedbackCategory @default(SUGGESTION)
  message   String
  // Path the reporter was on when they opened the form, for context.
  page      String?
  createdAt DateTime         @default(now())
}

// Multiple public booking pages per user (e.g. a 15-min quick chat vs. a
// 30-min deep dive), replacing the single bookingSlug/Enabled/Duration/
// Title fields AppSettings used to carry. Each is independently
// enable-able and has its own slug/title/duration.
model BookingLink {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug        String   @unique
  title       String
  durationMin Int
  enabled     Boolean  @default(true)
  // Comma-separated weekday codes (same "SU,MO,TU,..." format as
  // TimeSlot.daysOfWeek) that never offer a slot on this link, e.g.
  // "SA,SU" to decline weekend bookings. Null/empty = every day the
  // normal work-hours window already allows.
  excludeDays String?
  // Minimum lead time before a booking, in minutes — a visitor can't
  // book (and availability won't even list) a slot starting sooner than
  // this from "now". Google Calendar's Appointment Schedules call this
  // the same thing. 60 = the same "at least an hour's notice" default
  // most scheduling tools ship with.
  minNoticeMin Int      @default(60)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// One-time, short-lived token for the "forgot password" email link
// (src/app/authActions.ts). Deliberately its own table rather than a
// column on User — a used or expired token is just deleted, no need to
// carry reset state on the account row itself.
model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// The owner directly grants access to a specific person — no
// request/accept flow, since this is "you + friends you trust" sharing
// with each other directly, not a public/discoverable thing. View-only:
// BUSY_ONLY shows plain untitled "Busy" blocks on the viewer's calendar
// (Google's own default privacy level), FULL_DETAILS shows the real
// title/notes. Editing someone else's calendar isn't supported — that
// would mean rethinking every server action's ownership check, the exact
// bug class the 2026-08-19/20 security audits fixed.
model CalendarShare {
  id           String          @id @default(cuid())
  ownerId      String
  owner        User            @relation("SharesGiven", fields: [ownerId], references: [id], onDelete: Cascade)
  sharedWithId String
  sharedWith   User            @relation("SharesReceived", fields: [sharedWithId], references: [id], onDelete: Cascade)
  permission   SharePermission @default(BUSY_ONLY)
  createdAt    DateTime        @default(now())
  // Recipient-side "show on my calendar" toggle (Google Calendar's
  // checkbox on each entry under "Other calendars") — the owner still
  // grants/revokes the share itself; this only controls whether the
  // recipient currently wants the overlay cluttering their own view.
  hiddenByRecipient Boolean    @default(false)

  @@unique([ownerId, sharedWithId])
}

enum SharePermission {
  BUSY_ONLY
  FULL_DETAILS
}

// Trigger = a task's status changing to `triggerStatus` (optionally
// scoped to one project); action = one of a small fixed set below,
// reusing features already built elsewhere (AI subtasks, AI email
// drafts) rather than a general-purpose action language. Evaluated by
// runAutomationsForStatusChange in src/lib/automations.ts, called from
// every place a task's status actually changes (setTaskStatusAction,
// toggleTaskDone, delayTaskAction).
enum AutomationAction {
  NOTIFY
  GENERATE_SUBTASKS
  DRAFT_EMAIL
  SET_PRIORITY_URGENT
}

model AutomationRule {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  triggerStatus TaskStatus
  projectId     String?
  project       Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  action        AutomationAction
  enabled       Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

// Queued by the NOTIFY action, polled by NotificationWatcher.tsx the
// same way it already polls for upcoming-event reminders — a real
// browser Notification, not a DB-only "inbox" nobody looks at.
model AutomationNotification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  seen      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Flexible recurring routine time-blocking (Reclaim.ai's "Habits"),
// distinct from a fixed recurring Event and from a recurring Task
// (which materializes one occurrence at a time on completion). A Habit
// just wants `timesPerWeek` slots of `durationMin` somewhere in the
// week — src/lib/habits.ts places them in open slots each week and
// re-places (not just drops) an occurrence whose slot gets conflicted
// out by something else, via the same conflict path scheduled tasks use
// (rescheduleConflictsWith in scheduler.ts).
model Habit {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  durationMin  Int
  timesPerWeek Int
  priority     Int      @default(0) // same 0=Low..3=Urgent scale as Task.priority
  enabled      Boolean  @default(true)
  events       Event[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// A named, user-configurable weekly availability window (Work/Sleep/
// School/custom) — replaces this app's previously-hardcoded 9am-6pm
// weekday assumption with something a user can actually set. A Task
// left unassigned (timeSlotId: null) still schedules against that same
// default window (see scheduler.ts's defaultWindowFn) — this only
// narrows scheduling for tasks explicitly assigned to a slot.
model TimeSlot {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  // Comma-separated weekday codes, same format/order as Event's custom-
  // weekly RRULE BYDAY (src/lib/recurrence.ts's WEEKDAY_CODES) — e.g.
  // "MO,TU,WE,TH,FR".
  daysOfWeek String
  startMin   Int // minutes after midnight, e.g. 9:00am = 540
  endMin     Int // e.g. 6:00pm = 1080
  tasks      Task[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
