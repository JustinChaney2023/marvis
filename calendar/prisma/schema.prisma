generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Real per-person accounts (added when this moved from a single-user app
// toward self-hosted + friends). userId columns below are nullable rather
// than required — this app ran for a while as genuinely single-user with
// no User table at all, and a hard NOT NULL migration against that
// pre-existing data risks an unrecoverable failure. Instead, the first
// person to sign up (src/app/authActions.ts) adopts every row that still
// has userId: null, and every write from that point on always sets it —
// nullable is a migration safety valve, not a supported "ownerless" state.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  // The first account created (during the single-user -> multi-user
  // migration, or on a fresh install) — gates the feedback inbox and any
  // future admin-only surface. Not a general role system.
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())

  sessions      Session[]
  events        Event[]
  tasks         Task[]
  projects      Project[]
  googleAccount GoogleAccount?
  appleAccount  AppleAccount?
  settings      AppSettings?
  assignees     Assignee[]
  feedback      Feedback[]
  bookingLinks  BookingLink[]
  automationRules         AutomationRule[]
  automationNotifications AutomationNotification[]
  timeLogEntries          TimeLogEntry[]
  habits                  Habit[]
  timeSlots               TimeSlot[]
}

// DB-backed sessions (not signed/stateless JWTs) — lets a logout or a
// password change actually revoke access immediately, which a bare signed
// cookie can't do without a separate revocation list anyway.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Event {
  id              String      @id @default(cuid())
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  // Video-call link (Zoom/Meet/whatever) shown by MeetingBanner.tsx when
  // the event's about to start — plain URL, no per-provider parsing.
  meetingUrl      String?
  start           DateTime
  end             DateTime
  allDay          Boolean     @default(false)
  notes           String?
  // Explicit override of the Tailwind color family this event's block
  // renders in (see PROJECT_EVENT_COLORS in CalendarClient.tsx). Null =
  // fall back to the linked task's own color, then its project's, then
  // the default indigo — same resolution page.tsx already does for
  // projectColor.
  color           String?
  // RRULE string (no DTSTART line — `start` above is the recurrence's
  // DTSTART), e.g. "FREQ=WEEKLY;BYDAY=MO,WE,FR". Null = a one-off event.
  // Occurrences are computed on the fly (src/lib/recurrence.ts), never
  // materialized as rows — editing/deleting acts on the whole series.
  recurrenceRule  String?
  // Excluded from auto-rescheduling (src/lib/scheduler.ts's stale-task
  // sweep never moves a locked event, even if its slot looks stale).
  locked          Boolean     @default(false)
  taskId          String?     @unique
  task            Task?       @relation(fields: [taskId], references: [id])
  // A Habit occurrence, unlike a Task's slot, isn't 1:1 — a habit with
  // timesPerWeek: 3 has 3 Event rows sharing the same habitId each week,
  // so no unique constraint here (see Habit below).
  habitId         String?
  habit           Habit?      @relation(fields: [habitId], references: [id], onDelete: Cascade)
  // Google Calendar sync (src/lib/google-sync.ts). source LOCAL means
  // this app owns it and pushes it to Google; GOOGLE means it was pulled
  // from Google and edits here get pushed back. Dirty tracking can't use
  // updatedAt (Prisma's @updatedAt bumps it on every write, including
  // google-sync's own bookkeeping, which would mark every row dirty on
  // every sync) — localDirty is set only by actual user edits and cleared
  // once exportToGoogle successfully pushes it.
  source          EventSource @default(LOCAL)
  googleEventId   String?     @unique
  googleUpdatedAt DateTime?
  localDirty      Boolean     @default(false)
  // CalDAV UID for Apple-synced events (src/lib/apple-sync.ts) — read-only
  // overlay, no push-back, so unlike Google there's no dirty-tracking here.
  appleEventUid   String?     @unique
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

enum EventSource {
  LOCAL
  GOOGLE
  APPLE
}

// One connected Google account per user (was a single global row back when
// this was single-user).
model GoogleAccount {
  id           String    @id @default(cuid())
  userId       String?   @unique
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  // Google's primary calendar id (usually the account email) events sync
  // to/from — kept explicit rather than hardcoding "primary" everywhere.
  calendarId   String    @default("primary")
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// One connected Apple/iCloud CalDAV account per user — read-only overlay
// (src/lib/apple-sync.ts pulls events in as source: APPLE, locked so they
// can't be dragged; nothing is ever pushed back to iCloud), unlike the
// two-way Google sync above. Auth is an iCloud app-specific password
// (appleprivacy.apple.com/account/manage), not OAuth — Apple has no
// public CalDAV OAuth flow for third-party apps.
model AppleAccount {
  id           String    @id @default(cuid())
  userId       String?   @unique
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appleId      String
  // Encrypted at rest via src/lib/tokenCrypto.ts when TOKEN_ENCRYPTION_KEY
  // is set, same as Google's tokens.
  appPassword  String
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// A task's lifecycle is independent of whether it has a calendar slot
// (that's tracked by Event.taskId, not here) — CREATED/ONGOING tasks with
// no event yet are exactly what the auto-scheduler sweeps for. ONGOING
// can be set manually ("I'm working on this now") or is shown by the UI
// automatically whenever now falls inside the task's scheduled event
// window — that display-only computation isn't a stored value, see
// TaskRow.tsx. DELAYED always means "explicitly pushed off" (dueAt
// bumped, unscheduled if it had a slot) — it's a deliberate action, never
// inferred.
enum TaskStatus {
  CREATED
  ONGOING
  DELAYED
  DONE
}

// Deep-work tasks are scored toward morning slots, admin toward afternoon
// — see ENERGY_PREFERRED_HOURS in src/lib/scheduler.ts. The manual picker
// for this was removed from the task UI (defaults to MEDIUM = no
// preference) — the field and scheduler logic stay, since the plan is to
// eventually derive this automatically (e.g. from sleep/energy data)
// rather than have the user pick it by hand.
enum TaskEnergy {
  LOW
  MEDIUM
  HIGH
}

// Who a task is assigned to — a person (you, a friend) or an "AI
// employee". Deliberately just a label for now: assigning a task to an AI
// employee puts it on their name/calendar like any teammate, but nothing
// autonomously executes it yet. See docs/motion-feature-backlog.md.
enum AssigneeType {
  HUMAN
  AI
}

model Assignee {
  id        String       @id @default(cuid())
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  role      String?
  type      AssigneeType @default(HUMAN)
  tasks     Task[]
  createdAt DateTime     @default(now())
}

// Auto-scheduling inputs, modeled after FluidCalendar's scoring approach
// (due date / priority / duration) — see docs/fluidcalendar.md.
model Task {
  id             String     @id @default(cuid())
  userId         String?
  user           User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  notes          String?
  status         TaskStatus @default(CREATED)
  priority       Int        @default(0) // 0 = low .. 3 = urgent
  energy         TaskEnergy @default(MEDIUM)
  durationMin    Int        @default(30) // the estimate
  // Actual time tracked, accumulated across every ONGOING session (not
  // just the current one) — see finalizeTaskTimer in src/app/actions.ts.
  trackedMinutes Int        @default(0)
  // Set when the task becomes ONGOING (manually, via the timer), cleared
  // and folded into trackedMinutes whenever it leaves ONGOING. Null =
  // no timer currently running.
  timerStartedAt DateTime?
  // Earliest day the scheduler may place this task — optional, unlike
  // dueAt. A plain lower bound on scheduling, not a hard commitment like
  // an Event's start.
  startAt        DateTime?
  dueAt          DateTime?
  // RRULE string, same format as Event.recurrenceRule, anchored to
  // `dueAt` (a recurring task must have a dueAt — it's the DTSTART for
  // computing the next occurrence). Unlike Events, occurrences ARE
  // materialized: marking a recurring task done creates the next Task
  // row rather than expanding virtual instances, since a task carries
  // per-instance mutable state (status, its own scheduled event) that
  // doesn't fit the "compute on the fly" model Events use.
  recurrenceRule String?
  // Explicit override of the Tailwind color family this task (and its
  // scheduled Event block, if any) renders in. Null = fall back to the
  // project's color, then the default indigo.
  color          String?
  projectId      String?
  project        Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assigneeId     String?
  assignee       Assignee?  @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  // Restricts auto-scheduling to this slot's own windows (e.g. "School")
  // instead of the default 9-6 weekday work window. Null = default.
  timeSlotId     String?
  timeSlot       TimeSlot?  @relation(fields: [timeSlotId], references: [id], onDelete: SetNull)
  event          Event?
  // One level of subtasks (a subtask can't itself have subtasks — this
  // app doesn't enforce that in the schema, but nothing in the UI ever
  // creates a subtask of a subtask). Deleting the parent deletes its
  // subtasks rather than orphaning them.
  parentId       String?
  parent         Task?      @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks       Task[]     @relation("TaskSubtasks")
  timeLogEntries TimeLogEntry[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

// One row per timer stop (see stoppedTimerFields in actions.ts) — lets
// the time-tracking report bucket by week/project, which the plain
// cumulative Task.trackedMinutes total can't do on its own.
model TimeLogEntry {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId   String
  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  minutes  Int
  loggedAt DateTime @default(now())
}

// Per-user scheduler knobs and booking-page config (was a single global
// row back when this was single-user).
model AppSettings {
  id                 String   @id @default(cuid())
  userId             String?  @unique
  user               User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  bufferMin          Int      @default(10)
  // "Breathing room" — once a day's already-scheduled task minutes (within
  // work hours) reach this, the auto-scheduler stops placing new tasks
  // that day and moves on to the next, leaving slack for unplanned work
  // instead of packing every open slot. Null = no cap (previous behavior).
  dailyCapMin        Int?
  // Optional self-hosted model for /tasks/import (e.g. Ollama on a home
  // desktop, reachable at a Tailscale address from other devices) — an
  // OpenAI-compatible chat-completions endpoint. When set, syllabus
  // extraction calls this instead of the Claude API, so it isn't
  // subscription-dependent. Null = use Claude (needs ANTHROPIC_API_KEY).
  localAiUrl         String?
  localAiModel       String?
  updatedAt          DateTime @updatedAt
}

model Project {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  // Tailwind color family name (e.g. "indigo", "amber") used to derive
  // badge/pill classes — see PROJECT_COLORS in src/app/page.tsx.
  color     String   @default("zinc")
  tasks     Task[]
  automationRules AutomationRule[]
  createdAt DateTime @default(now())
}

enum FeedbackCategory {
  BUG
  SUGGESTION
  OTHER
}

// Free-form in-app feedback (feedback button, any page) — lands here
// instead of email/Slack so it's queryable while iterating on the app.
model Feedback {
  id        String           @id @default(cuid())
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  category  FeedbackCategory @default(SUGGESTION)
  message   String
  // Path the reporter was on when they opened the form, for context.
  page      String?
  createdAt DateTime         @default(now())
}

// Multiple public booking pages per user (e.g. a 15-min quick chat vs. a
// 30-min deep dive), replacing the single bookingSlug/Enabled/Duration/
// Title fields AppSettings used to carry. Each is independently
// enable-able and has its own slug/title/duration.
model BookingLink {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug        String   @unique
  title       String
  durationMin Int
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Trigger = a task's status changing to `triggerStatus` (optionally
// scoped to one project); action = one of a small fixed set below,
// reusing features already built elsewhere (AI subtasks, AI email
// drafts) rather than a general-purpose action language. Evaluated by
// runAutomationsForStatusChange in src/lib/automations.ts, called from
// every place a task's status actually changes (setTaskStatusAction,
// toggleTaskDone, delayTaskAction).
enum AutomationAction {
  NOTIFY
  GENERATE_SUBTASKS
  DRAFT_EMAIL
  SET_PRIORITY_URGENT
}

model AutomationRule {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  triggerStatus TaskStatus
  projectId     String?
  project       Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  action        AutomationAction
  enabled       Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

// Queued by the NOTIFY action, polled by NotificationWatcher.tsx the
// same way it already polls for upcoming-event reminders — a real
// browser Notification, not a DB-only "inbox" nobody looks at.
model AutomationNotification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  seen      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Flexible recurring routine time-blocking (Reclaim.ai's "Habits"),
// distinct from a fixed recurring Event and from a recurring Task
// (which materializes one occurrence at a time on completion). A Habit
// just wants `timesPerWeek` slots of `durationMin` somewhere in the
// week — src/lib/habits.ts places them in open slots each week and
// re-places (not just drops) an occurrence whose slot gets conflicted
// out by something else, via the same conflict path scheduled tasks use
// (rescheduleConflictsWith in scheduler.ts).
model Habit {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  durationMin  Int
  timesPerWeek Int
  priority     Int      @default(0) // same 0=Low..3=Urgent scale as Task.priority
  enabled      Boolean  @default(true)
  events       Event[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// A named, user-configurable weekly availability window (Work/Sleep/
// School/custom) — replaces this app's previously-hardcoded 9am-6pm
// weekday assumption with something a user can actually set. A Task
// left unassigned (timeSlotId: null) still schedules against that same
// default window (see scheduler.ts's defaultWindowFn) — this only
// narrows scheduling for tasks explicitly assigned to a slot.
model TimeSlot {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  // Comma-separated weekday codes, same format/order as Event's custom-
  // weekly RRULE BYDAY (src/lib/recurrence.ts's WEEKDAY_CODES) — e.g.
  // "MO,TU,WE,TH,FR".
  daysOfWeek String
  startMin   Int // minutes after midnight, e.g. 9:00am = 540
  endMin     Int // e.g. 6:00pm = 1080
  tasks      Task[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
